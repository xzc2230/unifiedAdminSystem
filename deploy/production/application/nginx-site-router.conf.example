# Separate from the existing admin server. Replace ALL host/certificate values.
# Each accepted hostname must be a verified domain in an approved release.
server {
    listen 80;
    server_name www.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name www.example.com;
    ssl_certificate /etc/jeecg/certs/www.example.com/fullchain.pem;
    ssl_certificate_key /etc/jeecg/certs/www.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64m;
    client_body_timeout 30s;

    location / {
        proxy_pass http://127.0.0.1:18090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Upgrade "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}

# Configure an independent default_server returning 444/421 for unrecognized
# hosts, plus a default TLS server with an operator-managed default certificate.
# Do not make the admin server a catch-all, or route /site-platform/node/* here.
