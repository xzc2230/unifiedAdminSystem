MIDDLEWARE_HOST=10.20.0.10
# Optional ClickHouse statistics; provision schema/users before enabling.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_ENDPOINT=http://127.0.0.1:18123
CLICKHOUSE_WRITER_USER=jeecg_writer
CLICKHOUSE_WRITER_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
CLICKHOUSE_READER_USER=jeecg_reader
CLICKHOUSE_READER_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_HEX_PASSWORD
JEECG_PUBLIC_URL=https://admin.example.com
JEECG_DB_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
JEECG_REDIS_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# Must match frontend src/utils/encryption/signMd5Utils.js at build time.
# This is browser-visible signing material, not a private authentication secret.
JEECG_SIGNATURE_SECRET=REPLACE_WITH_SAME_FRONTEND_SIGN_VALUE
