# Documentation only: setup.ps1 generates secrets; never use these placeholders.
# Actual protected file: deploy/clickhouse/.runtime/clickhouse.env (gitignored).
CLICKHOUSE_ENABLED=true
CLICKHOUSE_ENDPOINT=http://127.0.0.1:18123
CLICKHOUSE_WRITER_USER=jeecg_writer
CLICKHOUSE_WRITER_PASSWORD=GENERATED_BY_SETUP
CLICKHOUSE_READER_USER=jeecg_reader
CLICKHOUSE_READER_PASSWORD=GENERATED_BY_SETUP
# Bootstrap only; do not inject these two values into the backend.
CLICKHOUSE_ADMIN_PASSWORD=GENERATED_BY_SETUP
CLICKHOUSE_ADMIN_SHA256=GENERATED_BY_SETUP
