<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.ReviewsRecordMapper">
    
    <resultMap type="org.jeecg.modules.packagemanagement.domain.system.ReviewsRecord" id="ReviewsRecordResult">
        <result property="reviewsId"    column="reviews_id"    />
        <result property="appId"    column="app_id"    />
        <result property="headPortraitUrl"    column="head_portrait_url"    />
        <result property="name"    column="name"    />
        <result property="content"    column="content"    />
        <result property="score"    column="score"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectReviewsRecordVo">
        select reviews_id,app_id, head_portrait_url, name, content, score, create_time from pkg_review
    </sql>

    <select id="selectReviewsRecordList" parameterType="org.jeecg.modules.packagemanagement.domain.system.ReviewsRecord" resultMap="ReviewsRecordResult">
        <include refid="selectReviewsRecordVo"/>
        <where>  
            <if test="headPortraitUrl != null  and headPortraitUrl != ''"> and head_portrait_url = #{headPortraitUrl}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="score != null "> and score = #{score}</if>
            <if test="appId != null "> and app_id = #{appId}</if>
        </where>
    </select>
    
    <select id="selectReviewsRecordByReviewsId" parameterType="Long" resultMap="ReviewsRecordResult">
        <include refid="selectReviewsRecordVo"/>
        where reviews_id = #{reviewsId}
    </select>
        
    <insert id="insertReviewsRecord" parameterType="org.jeecg.modules.packagemanagement.domain.system.ReviewsRecord" useGeneratedKeys="true" keyProperty="reviewsId">
        insert into pkg_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="headPortraitUrl != null">head_portrait_url,</if>
            <if test="appId != null">app_id,</if>
            <if test="name != null">name,</if>
            <if test="content != null">content,</if>
            <if test="score != null">score,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="headPortraitUrl != null">#{headPortraitUrl},</if>
            <if test="appId != null">#{appId},</if>
            <if test="name != null">#{name},</if>
            <if test="content != null">#{content},</if>
            <if test="score != null">#{score},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateReviewsRecord" parameterType="org.jeecg.modules.packagemanagement.domain.system.ReviewsRecord">
        update pkg_review
        <trim prefix="SET" suffixOverrides=",">
            <if test="headPortraitUrl != null">head_portrait_url = #{headPortraitUrl},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="content != null">content = #{content},</if>
            <if test="score != null">score = #{score},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where reviews_id = #{reviewsId}
    </update>

    <delete id="deleteReviewsRecordByReviewsId" parameterType="Long">
        delete from pkg_review where reviews_id = #{reviewsId}
    </delete>

    <delete id="deleteReviewsRecordByReviewsIds" parameterType="String">
        delete from pkg_review where reviews_id in 
        <foreach item="reviewsId" collection="array" open="(" separator="," close=")">
            #{reviewsId}
        </foreach>
    </delete>
</mapper>