<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.LoadCountMapper">

    <resultMap type="org.jeecg.modules.packagemanagement.domain.event.LoadCount" id="LoadCountResult">
        <result property="id"    column="id"    />
        <result property="hostName"    column="hostName"    />
        <result property="time"    column="time"    />
        <result property="access"    column="access"    />
        <result property="download"    column="download"    />
        <result property="userId"    column="user_id"    />
        <result property="appId"    column="app_id"    />
    </resultMap>

    <sql id="selectLoadCountVo">
        select id, hostName, time, access, download,user_id,app_id from pkg_load_count
    </sql>

    <select id="selectLoadCountList" parameterType="org.jeecg.modules.packagemanagement.domain.event.LoadCount" resultMap="LoadCountResult">
        <include refid="selectLoadCountVo"/>
        <where>
            <if test="hostName != null  and hostName != ''"> and hostName like concat('%', #{hostName}, '%')</if>
            <if test="time != null "> and DATE_FORMAT( `time`, '%Y-%m-%d') = DATE_FORMAT(#{time}, '%Y-%m-%d')</if>
            <if test="access != null "> and access = #{access}</if>
            <if test="download != null "> and download = #{download}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="appId != null "> and app_id = #{appId}</if>
        </where>
    </select>

    <select id="selectLoadCountById" parameterType="Long" resultMap="LoadCountResult">
        <include refid="selectLoadCountVo"/>
        where id = #{id}
    </select>

    <select id="selectLoadCountByHostName" parameterType="String" resultMap="LoadCountResult">
        <include refid="selectLoadCountVo"/>
        where hostName = #{hostName}
    </select>

    <insert id="insertLoadCount" parameterType="org.jeecg.modules.packagemanagement.domain.event.LoadCount" useGeneratedKeys="true" keyProperty="id">
        insert into pkg_load_count
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="hostName != null">hostName,</if>
            <if test="time != null">time,</if>
            <if test="access != null">access,</if>
            <if test="download != null">download,</if>
            <if test="userId != null">user_id,</if>
            <if test="appId != null">app_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="hostName != null">#{hostName},</if>
            <if test="time != null">#{time},</if>
            <if test="access != null">#{access},</if>
            <if test="download != null">#{download},</if>
            <if test="userId != null">#{userId},</if>
            <if test="appId != null">#{appId},</if>
         </trim>
    </insert>

    <update id="updateLoadCount" parameterType="org.jeecg.modules.packagemanagement.domain.event.LoadCount">
        update pkg_load_count
        <trim prefix="SET" suffixOverrides=",">
            <if test="hostName != null">hostName = #{hostName},</if>
            <if test="time != null">time = #{time},</if>
            <if test="access != null">access = #{access},</if>
            <if test="download != null">download = #{download},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="appId != null">app_id = #{appId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLoadCountById" parameterType="Long">
        delete from pkg_load_count where id = #{id}
    </delete>

    <delete id="deleteLoadCountByIds" parameterType="String">
        delete from pkg_load_count where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
