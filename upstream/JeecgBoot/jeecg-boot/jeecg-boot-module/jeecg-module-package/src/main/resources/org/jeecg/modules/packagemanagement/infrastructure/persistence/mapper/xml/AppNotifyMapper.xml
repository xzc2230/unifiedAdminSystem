<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.AppNotifyMapper">
    
    <resultMap type="org.jeecg.modules.packagemanagement.domain.notify.AppNotify" id="AppNotifyResult">
        <result property="id"    column="id"    />
        <result property="appId"    column="app_id"    />
        <result property="userId"    column="user_id"    />
        <result property="appName"    column="app_name"    />
        <result property="appIcon"    column="app_icon"    />
        <result property="appHost"    column="app_host"    />
        <result property="notifyTitle"    column="notify_title"    />
        <result property="notifyMessage"    column="notify_message"    />
        <result property="notifyIcon"    column="notify_icon"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectAppNotifyVo">
        select id, app_id,user_id,app_name, app_icon, app_host, notify_title, notify_message, notify_icon, create_time from pkg_notification
    </sql>

    <select id="selectAppNotifyList" parameterType="org.jeecg.modules.packagemanagement.domain.notify.AppNotify" resultMap="AppNotifyResult">
        <include refid="selectAppNotifyVo"/>
        <where>  
            <if test="appName != null  and appName != ''"> and app_name like concat('%', #{appName}, '%')</if>
            <if test="appId != null  and appId != ''"> and app_id = #{appId}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="appIcon != null  and appIcon != ''"> and app_icon = #{appIcon}</if>
            <if test="appHost != null  and appHost != ''"> and app_host = #{appHost}</if>
            <if test="notifyTitle != null  and notifyTitle != ''"> and notify_title = #{notifyTitle}</if>
            <if test="notifyMessage != null  and notifyMessage != ''"> and notify_message = #{notifyMessage}</if>
            <if test="notifyIcon != null  and notifyIcon != ''"> and notify_icon = #{notifyIcon}</if>
        </where>
    </select>
    
    <select id="selectAppNotifyById" parameterType="Long" resultMap="AppNotifyResult">
        <include refid="selectAppNotifyVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAppNotify" parameterType="org.jeecg.modules.packagemanagement.domain.notify.AppNotify" useGeneratedKeys="true" keyProperty="id">
        insert into pkg_notification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appName != null">app_name,</if>
            <if test="appIcon != null">app_icon,</if>
            <if test="appId != null">app_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="appHost != null">app_host,</if>
            <if test="notifyTitle != null">notify_title,</if>
            <if test="notifyMessage != null">notify_message,</if>
            <if test="notifyIcon != null">notify_icon,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appName != null">#{appName},</if>
            <if test="appIcon != null">#{appIcon},</if>
            <if test="appId != null">#{appId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="appHost != null">#{appHost},</if>
            <if test="notifyTitle != null">#{notifyTitle},</if>
            <if test="notifyMessage != null">#{notifyMessage},</if>
            <if test="notifyIcon != null">#{notifyIcon},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateAppNotify" parameterType="org.jeecg.modules.packagemanagement.domain.notify.AppNotify">
        update pkg_notification
        <trim prefix="SET" suffixOverrides=",">
            <if test="appName != null">app_name = #{appName},</if>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="appIcon != null">app_icon = #{appIcon},</if>
            <if test="appHost != null">app_host = #{appHost},</if>
            <if test="notifyTitle != null">notify_title = #{notifyTitle},</if>
            <if test="notifyMessage != null">notify_message = #{notifyMessage},</if>
            <if test="notifyIcon != null">notify_icon = #{notifyIcon},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppNotifyById" parameterType="Long">
        delete from pkg_notification where id = #{id}
    </delete>

    <delete id="deleteAppNotifyByIds" parameterType="String">
        delete from pkg_notification where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>