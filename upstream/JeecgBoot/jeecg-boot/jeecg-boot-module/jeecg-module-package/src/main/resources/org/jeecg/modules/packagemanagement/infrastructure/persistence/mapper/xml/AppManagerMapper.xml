<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.AppManagerMapper">

    <resultMap type="org.jeecg.modules.packagemanagement.domain.app.AppManager" id="AppManagerResult">
        <result property="id" column="id"/>
        <result property="appName" column="app_name"/>
        <result property="areas" column="areas"/>
        <result property="author" column="author"/>
        <result property="createDate" column="create_date"/>
        <result property="mark" column="mark"/>
        <result property="packageCode" column="package_code"/>
        <result property="status" column="status"/>
        <result property="updateDate" column="update_date"/>
        <result property="url" column="url"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="whetherRestrict" column="whether_restrict"/>
        <result property="whetherUs" column="whether_us"/>
        <result property="whetherUse" column="whether_use"/>
    </resultMap>

    <sql id="selectAppManagerVo">
        select id,
               app_name,
               areas,
               author,
               create_date,
               mark,
               package_code,
               status,
               update_date,
               url,
               whether_restrict,
               whether_us,
               user_id,
               user_name,
               whether_use
        from pkg_app_manager
    </sql>

    <select id="selectAppManagerList" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        <where>
            <if test="id != null ">and id = #{id}</if>
            <if test="appName != null  and appName != ''">and app_name like concat('%', #{appName}, '%')</if>
            <if test="areas != null  and areas != ''">and areas = #{areas}</if>
            <if test="author != null  and author != ''">and author = #{author}</if>
            <if test="createDate != null ">and create_date = #{createDate}</if>
            <if test="mark != null  and mark != ''">and mark = #{mark}</if>
            <if test="packageCode != null  and packageCode != ''">and package_code like concat('%', #{packageCode}, '%')</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="updateDate != null ">and update_date = #{updateDate}</if>
            <if test="url != null  and url != ''">and url = #{url}</if>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="userName != null ">and user_name = #{userName}</if>
            <if test="whetherRestrict != null ">and whether_restrict = #{whetherRestrict}</if>
            <if test="whetherUs != null ">and whether_us = #{whetherUs}</if>
            <if test="whetherUse != null ">and whether_use = #{whetherUse}</if>
        </where>

        <!-- 排序：优先按 update_date 降序，如果没有 update_date 则按 create_date 降序 -->
        <choose>
            <when test="updateDate != null">
                ORDER BY update_date DESC
            </when>
            <otherwise>
                ORDER BY create_date DESC
            </otherwise>
        </choose>

    </select>

    <select id="selectAppManagerById" parameterType="Long" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where id = #{id}
    </select>


    <select id="selectAppManagerByPackageName" parameterType="String" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where package_code = #{packageName}
    </select>

    <insert id="insertAppManager" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager" useGeneratedKeys="true" keyProperty="id">
        insert into pkg_app_manager
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="appName != null">app_name,</if>
            <if test="areas != null">areas,</if>
            <if test="author != null">author,</if>
            <if test="createDate != null">create_date,</if>
            <if test="mark != null">mark,</if>
            <if test="packageCode != null">package_code,</if>
            <if test="status != null">status,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="url != null">url,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null ">user_name,</if>
            <if test="whetherRestrict != null">whether_restrict,</if>
            <if test="whetherUs != null">whether_us,</if>
            <if test="whetherUse != null">whether_use,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null ">#{id},</if>
            <if test="appName != null">#{appName},</if>
            <if test="areas != null">#{areas},</if>
            <if test="author != null">#{author},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="mark != null">#{mark},</if>
            <if test="packageCode != null">#{packageCode},</if>
            <if test="status != null">#{status},</if>
            <if test="updateDate != null">#{updateDate},</if>
            <if test="url != null">#{url},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null ">#{userName},</if>
            <if test="whetherRestrict != null">#{whetherRestrict},</if>
            <if test="whetherUs != null">#{whetherUs},</if>
            <if test="whetherUse != null">#{whetherUse},</if>
        </trim>
    </insert>

    <update id="updateAppManager" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager">
        update pkg_app_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="appName != null">app_name = #{appName},</if>
            <if test="areas != null">areas = #{areas},</if>
            <if test="author != null">author = #{author},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="mark != null">mark = #{mark},</if>
            <if test="packageCode != null">package_code = #{packageCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
            <if test="url != null">url = #{url},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="whetherRestrict != null">whether_restrict = #{whetherRestrict},</if>
            <if test="whetherUs != null">whether_us = #{whetherUs},</if>
            <if test="whetherUse != null">whether_use = #{whetherUse},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAppManagerById" parameterType="Long">
        delete
        from pkg_app_manager
        where id = #{id}
    </delete>

    <delete id="deleteAppManagerByIds" parameterType="String">
        delete from pkg_app_manager where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="transferAppManagerById" parameterType="String" >
        update pkg_app_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
        </trim>
        where package_code = #{id}
    </update>
</mapper>
