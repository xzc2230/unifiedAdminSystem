<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.AppManagerMapper">

    <resultMap type="org.jeecg.modules.packagemanagement.domain.app.AppManager" id="AppManagerResult">
        <result property="id" column="id"/>
        <result property="appName" column="app_name"/>
        <result property="areas" column="areas"/>
        <result property="author" column="author"/>
        <result property="createDate" column="create_date"/>
        <result property="mark" column="mark"/>
        <result property="packageCode" column="package_code"/>
        <result property="applicationCode" column="application_code"/>
        <result property="platform" column="platform"/>
        <result property="appleAppId" column="apple_app_id"/>
        <result property="storeRegion" column="store_region"/>
        <result property="status" column="status"/>
        <result property="updateDate" column="update_date"/>
        <result property="url" column="url"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="whetherRestrict" column="whether_restrict"/>
        <result property="whetherUs" column="whether_us"/>
        <result property="whetherUse" column="whether_use"/>
        <result property="gaidAidThreshold" column="gaid_aid_threshold"/>
        <result property="aidDeviceThreshold" column="aid_device_threshold"/>
        <result property="aidGaidSwitchThreshold" column="aid_gaid_switch_threshold"/>
        <result property="riskWindowSeconds" column="risk_window_seconds"/>
        <result property="referrerBlacklistJson" column="referrer_blacklist_json"/>
        <result property="systemTimezone" column="system_timezone"/>
        <result property="whetherTimezoneRestrict" column="whether_timezone_restrict"/>
        <result property="simCountry" column="sim_country"/>
        <result property="whetherSimCountryRestrict" column="whether_sim_country_restrict"/>
    </resultMap>

    <sql id="selectAppManagerVo">
        select id,
               app_name,
               areas,
               author,
               create_date,
               mark,
               package_code,
               application_code,
               platform,
               apple_app_id,
               store_region,
               status,
               update_date,
               url,
               whether_restrict,
               whether_us,
               user_id,
               user_name,
               gaid_aid_threshold,
               aid_device_threshold,
               aid_gaid_switch_threshold,
               risk_window_seconds,
               referrer_blacklist_json,
               system_timezone,
               whether_timezone_restrict,
               sim_country,
               whether_sim_country_restrict,
               whether_use
        from pkg_app_manager
    </sql>

    <select id="selectAppManagerList" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        <where>
            <if test="id != null ">and id = #{id}</if>
            <if test="appName != null  and appName != ''">and app_name like concat('%', #{appName}, '%')</if>
            <if test="areas != null  and areas != ''">and areas = #{areas}</if>
            <if test="author != null  and author != ''">and author = #{author}</if>
            <if test="createDate != null ">and create_date = #{createDate}</if>
            <if test="mark != null  and mark != ''">and mark = #{mark}</if>
            <if test="packageCode != null  and packageCode != ''">and package_code like concat('%', #{packageCode}, '%')</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="updateDate != null ">and update_date = #{updateDate}</if>
            <if test="url != null  and url != ''">and url = #{url}</if>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="userName != null ">and user_name = #{userName}</if>
            <if test="whetherRestrict != null ">and whether_restrict = #{whetherRestrict}</if>
            <if test="whetherUs != null ">and whether_us = #{whetherUs}</if>
            <if test="whetherUse != null ">and whether_use = #{whetherUse}</if>
        </where>

        <!-- 排序：优先按 update_date 降序，如果没有 update_date 则按 create_date 降序 -->
        <choose>
            <when test="updateDate != null">
                ORDER BY update_date DESC
            </when>
            <otherwise>
                ORDER BY create_date DESC
            </otherwise>
        </choose>

    </select>

    <select id="selectAppManagerById" parameterType="Long" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where id = #{id}
    </select>


    <select id="selectAppManagerByPackageName" parameterType="String" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where package_code = #{packageName}
        <!-- mixed-platform package returns the android row until client lookup becomes platform-aware -->
        order by case platform when 'android' then 0 else 1 end, id
        limit 1
    </select>

    <select id="selectAppManagerByPlatformAndPackage" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where platform = #{platform} and package_code = #{packageCode}
    </select>

    <select id="selectAppManagerByApplicationCode" parameterType="String" resultMap="AppManagerResult">
        <include refid="selectAppManagerVo"/>
        where application_code = #{applicationCode}
    </select>

    <insert id="insertAppManager" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager" useGeneratedKeys="true" keyProperty="id">
        insert into pkg_app_manager
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="appName != null">app_name,</if>
            <if test="areas != null">areas,</if>
            <if test="author != null">author,</if>
            <if test="createDate != null">create_date,</if>
            <if test="mark != null">mark,</if>
            <if test="packageCode != null">package_code,</if>
            <if test="applicationCode != null">application_code,</if>
            <if test="platform != null">platform,</if>
            <if test="appleAppId != null">apple_app_id,</if>
            <if test="storeRegion != null">store_region,</if>
            <if test="status != null">status,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="url != null">url,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null ">user_name,</if>
            <if test="whetherRestrict != null">whether_restrict,</if>
            <if test="whetherUs != null">whether_us,</if>
            <if test="gaidAidThreshold != null">gaid_aid_threshold,</if>
            <if test="aidDeviceThreshold != null">aid_device_threshold,</if>
            <if test="aidGaidSwitchThreshold != null">aid_gaid_switch_threshold,</if>
            <if test="riskWindowSeconds != null">risk_window_seconds,</if>
            <if test="referrerBlacklistJson != null">referrer_blacklist_json,</if>
            <if test="systemTimezone != null">system_timezone,</if>
            <if test="whetherTimezoneRestrict != null">whether_timezone_restrict,</if>
            <if test="simCountry != null">sim_country,</if>
            <if test="whetherSimCountryRestrict != null">whether_sim_country_restrict,</if>
            <if test="whetherUse != null">whether_use,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null ">#{id},</if>
            <if test="appName != null">#{appName},</if>
            <if test="areas != null">#{areas},</if>
            <if test="author != null">#{author},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="mark != null">#{mark},</if>
            <if test="packageCode != null">#{packageCode},</if>
            <if test="applicationCode != null">#{applicationCode},</if>
            <if test="platform != null">#{platform},</if>
            <if test="appleAppId != null">#{appleAppId},</if>
            <if test="storeRegion != null">#{storeRegion},</if>
            <if test="status != null">#{status},</if>
            <if test="updateDate != null">#{updateDate},</if>
            <if test="url != null">#{url},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null ">#{userName},</if>
            <if test="whetherRestrict != null">#{whetherRestrict},</if>
            <if test="whetherUs != null">#{whetherUs},</if>
            <if test="gaidAidThreshold != null">#{gaidAidThreshold},</if>
            <if test="aidDeviceThreshold != null">#{aidDeviceThreshold},</if>
            <if test="aidGaidSwitchThreshold != null">#{aidGaidSwitchThreshold},</if>
            <if test="riskWindowSeconds != null">#{riskWindowSeconds},</if>
            <if test="referrerBlacklistJson != null">#{referrerBlacklistJson},</if>
            <if test="systemTimezone != null">#{systemTimezone},</if>
            <if test="whetherTimezoneRestrict != null">#{whetherTimezoneRestrict},</if>
            <if test="simCountry != null">#{simCountry},</if>
            <if test="whetherSimCountryRestrict != null">#{whetherSimCountryRestrict},</if>
            <if test="whetherUse != null">#{whetherUse},</if>
        </trim>
    </insert>

    <update id="updateAppManager" parameterType="org.jeecg.modules.packagemanagement.domain.app.AppManager">
        update pkg_app_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="appName != null">app_name = #{appName},</if>
            <if test="areas != null">areas = #{areas},</if>
            <if test="author != null">author = #{author},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="mark != null">mark = #{mark},</if>
            <if test="packageCode != null">package_code = #{packageCode},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="appleAppId != null">apple_app_id = #{appleAppId},</if>
            <if test="storeRegion != null">store_region = #{storeRegion},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
            <if test="url != null">url = #{url},</if>
            <if test="whetherRestrict != null">whether_restrict = #{whetherRestrict},</if>
            <if test="whetherUs != null">whether_us = #{whetherUs},</if>
            <if test="gaidAidThreshold != null">gaid_aid_threshold = #{gaidAidThreshold},</if>
            <if test="aidDeviceThreshold != null">aid_device_threshold = #{aidDeviceThreshold},</if>
            <if test="aidGaidSwitchThreshold != null">aid_gaid_switch_threshold = #{aidGaidSwitchThreshold},</if>
            <if test="riskWindowSeconds != null">risk_window_seconds = #{riskWindowSeconds},</if>
            <if test="referrerBlacklistJson != null">referrer_blacklist_json = #{referrerBlacklistJson},</if>
            <if test="systemTimezone != null">system_timezone = #{systemTimezone},</if>
            <if test="whetherTimezoneRestrict != null">whether_timezone_restrict = #{whetherTimezoneRestrict},</if>
            <if test="simCountry != null">sim_country = #{simCountry},</if>
            <if test="whetherSimCountryRestrict != null">whether_sim_country_restrict = #{whetherSimCountryRestrict},</if>
            <if test="whetherUse != null">whether_use = #{whetherUse},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="clearAppManagerAppleStoreIdentity">
        update pkg_app_manager
        set apple_app_id = null, store_region = null
        where id = #{id}
    </update>

    <delete id="deleteAppManagerById" parameterType="Long">
        delete
        from pkg_app_manager
        where id = #{id}
    </delete>

    <delete id="deleteAppManagerByIds" parameterType="String">
        delete from pkg_app_manager where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="transferAppManagerById" parameterType="String" >
        update pkg_app_manager
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>


        </trim>
        where package_code = #{id}
    </update>
</mapper>
