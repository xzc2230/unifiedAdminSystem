<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.packagemanagement.infrastructure.persistence.mapper.StoreStatusMapper">

    <resultMap type="org.jeecg.modules.packagemanagement.domain.store.StoreStatus" id="StoreStatusResult">
        <result property="id" column="id"/>
        <result property="packageCode" column="package_code"/>
        <result property="platform" column="platform"/>
        <result property="appleAppId" column="apple_app_id"/>
        <result property="storeRegion" column="store_region"/>
        <result property="status" column="status"/>
        <result property="productStatus" column="product_status"/>
        <result property="storeUrl" column="store_url"/>
        <result property="createDate"   column="create_date"/>
        <result property="successDate"   column="success_date"/>
        <result property="failDate"   column="fail_date"/>
        <result property="successEmail"   column="success_email"/>
        <result property="failEmail"   column="fail_email"/>
    </resultMap>

    <sql id="StoreStatus">
        select id,
               package_code,
               platform,
               apple_app_id,
               store_region,
               status,
               product_status,
               store_url,
               create_date,
               success_date,
               fail_date,
               success_email,
               fail_email
        from pkg_store_status
    </sql>

    <select id="selectStoreStatusList" parameterType="org.jeecg.modules.packagemanagement.domain.store.StoreStatus" resultMap="StoreStatusResult">
        <include refid="StoreStatus"/>
        <where>
            <if test="id != null ">and id = #{id}</if>
            <if test="packageCode != null  and packageCode != ''">and package_code like concat('%',#{packageCode},'%')</if>
            <choose>
                <when test="(statusIn != null and statusIn.size() &gt; 0) or (iosStatusIn != null and iosStatusIn.size() &gt; 0) or (iosProductIn != null and iosProductIn.size() &gt; 0)">
                    and (
                    <trim prefixOverrides="or">
                        <if test="statusIn != null and statusIn.size() &gt; 0">
                            status in
                            <foreach collection="statusIn" item="item" open="(" close=")" separator=",">#{item}</foreach>
                        </if>
                        <if test="iosStatusIn != null and iosStatusIn.size() &gt; 0">
                            or (platform = 'ios' and status in
                            <foreach collection="iosStatusIn" item="item" open="(" close=")" separator=",">#{item}</foreach>
                            )
                        </if>
                        <if test="iosProductIn != null and iosProductIn.size() &gt; 0">
                            or (platform = 'ios' and (
                            product_status in
                            <foreach collection="iosProductIn" item="item" open="(" close=")" separator=",">#{item}</foreach>
                            <if test="iosLegacyIn != null and iosLegacyIn.size() &gt; 0">
                                or (product_status is null and status in
                                <foreach collection="iosLegacyIn" item="item" open="(" close=")" separator=",">#{item}</foreach>
                                )
                            </if>
                            ))
                        </if>
                    </trim>
                    )
                </when>
                <when test="status != null">and status = #{status}</when>
            </choose>
            <if test="appleAppId != null and appleAppId != ''">and apple_app_id = #{appleAppId}</if>
            <if test="storeUrl != null  and store_url != ''">and store_url = #{storeUrl}</if>
        </where>
    </select>

    <select id="selectStoreStatusById" parameterType="Long" resultMap="StoreStatusResult">
        <include refid="StoreStatus"/>
        where id = #{id}
    </select>

    <select id="selectStoreStatusByPackageName" parameterType="String" resultMap="StoreStatusResult">
        <include refid="StoreStatus"/>
        where package_code = #{packageName}
        <!-- mixed-platform package returns the android row until client lookup becomes platform-aware -->
        order by case platform when 'android' then 0 else 1 end, id
        limit 1
    </select>

    <select id="selectStoreStatusByPlatformAndPackage" resultMap="StoreStatusResult">
        <include refid="StoreStatus"/>
        where platform = #{platform} and package_code = #{packageCode}
    </select>

    <insert id="insertStoreStatus" parameterType="org.jeecg.modules.packagemanagement.domain.store.StoreStatus" useGeneratedKeys="true" keyProperty="id">
        insert into pkg_store_status
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="packageCode != null">package_code,</if>
            <if test="platform != null">platform,</if>
            <if test="appleAppId != null">apple_app_id,</if>
            <if test="storeRegion != null">store_region,</if>
            <if test="status != null">status,</if>
            <if test="productStatus != null">product_status,</if>
            <if test="storeUrl != null">store_url,</if>
            <if test="createDate != null">create_date,</if>
            <if test="successEmail != null">success_email,</if>
            <if test="failEmail != null">fail_email,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null ">#{id},</if>
            <if test="packageCode != null">#{packageCode},</if>
            <if test="platform != null">#{platform},</if>
            <if test="appleAppId != null">#{appleAppId},</if>
            <if test="storeRegion != null">#{storeRegion},</if>
            <if test="status != null">#{status},</if>
            <if test="productStatus != null">#{productStatus},</if>
            <if test="storeUrl != null">#{storeUrl},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="successEmail != null">#{successEmail},</if>
            <if test="failEmail != null">#{failEmail},</if>
        </trim>
    </insert>

    <update id="resetStoreListing" parameterType="org.jeecg.modules.packagemanagement.domain.store.StoreStatus">
        update pkg_store_status
        set package_code = #{packageCode},
            platform = #{platform},
            store_url = #{storeUrl},
            status = #{status},
            success_date = NULL,
            fail_date = NULL,
            apple_app_id = #{appleAppId},
            store_region = #{storeRegion},
            product_status = NULL
        where id = #{id}
    </update>

    <update id="updateStoreStatusAndDate" parameterType="org.jeecg.modules.packagemanagement.domain.store.StoreStatus">
        update pkg_store_status
        <trim prefix="SET" suffixOverrides=",">
            <if test="packageCode != null">package_code = #{packageCode},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="appleAppId != null">apple_app_id = #{appleAppId},</if>
            <if test="storeRegion != null">store_region = #{storeRegion},</if>
            <if test="status != null">status = #{status},</if>
            <if test="productStatus != null">product_status = #{productStatus},</if>
            <if test="storeUrl != null">store_url = #{storeUrl},</if>
            <if test="successDate != null">success_date = #{successDate},</if>
            <if test="failDate != null">fail_date = #{failDate},</if>
            <if test="successEmail != null">success_email = #{successEmail},</if>
            <if test="failEmail != null">fail_email = #{failEmail},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateStoreStatus" parameterType="org.jeecg.modules.packagemanagement.domain.store.StoreStatus">
        update pkg_store_status
        <trim prefix="SET" suffixOverrides=",">
            <if test="packageCode != null">package_code = #{packageCode},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="appleAppId != null">apple_app_id = #{appleAppId},</if>
            <if test="storeRegion != null">store_region = #{storeRegion},</if>
            <if test="status != null">status = #{status},</if>
            <if test="productStatus != null">product_status = #{productStatus},</if>
            <if test="storeUrl != null">store_url = #{storeUrl},</if>
            <if test="successDate != null">success_date = #{successDate},</if>
            <if test="failDate != null">fail_date = #{failDate},</if>
            <if test="successEmail != null">success_email = #{successEmail},</if>
            <if test="failEmail != null">fail_email = #{failEmail},</if>
        </trim>
        where id = #{id}
    </update>



    <update id="updateStoreStatusById" parameterType="Long">
        update pkg_store_status
        <trim prefix="SET" suffixOverrides=",">
            status = 0,
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStoreStatusById" parameterType="Long">
        delete
        from pkg_store_status
        where id = #{id}
    </delete>

    <delete id="deleteStoreStatusByIds" parameterType="String">
        delete from pkg_store_status where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
