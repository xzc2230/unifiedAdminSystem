            <if test="appIcon != null">app_icon,</if>
            <if test="appCode != null">app_code,</if>
            <if test="appAdvertising != null">app_advertising,</if>
            <if test="appDescription != null">app_description,</if>
            <if test="appLanguage != null">app_language,</if>
            <if test="appHost != null">app_host,</if>
            <if test="appSubHost != null">app_sub_host,</if>
            <if test="appSub != null">app_sub,</if>
            <if test="appUrl != null">app_url,</if>
            <if test="appEvent != null">app_event,</if>
            <if test="appEventConf != null">app_event_conf,</if>
            <if test="userId != null">user_id,</if>
            <if test="appCreateTime != null">app_create_time,</if>
            <if test="appChangeTime != null">app_change_time,</if>
            <if test="linkId != null">link_id,</if>
            <if test="publicKey != null">public_key,</if>
            <if test="privateKey != null">private_key,</if>
            <if test="downloadUrl != null">download_url,</if>
            <if test="appType != null">app_type,</if>
            <if test="downloadCount != null">download_count,</if>
            <if test="score != null">score,</if>
            <if test="reviews != null">reviews,</if>
            <if test="tags != null">tags,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appName != null">#{appName},</if>
