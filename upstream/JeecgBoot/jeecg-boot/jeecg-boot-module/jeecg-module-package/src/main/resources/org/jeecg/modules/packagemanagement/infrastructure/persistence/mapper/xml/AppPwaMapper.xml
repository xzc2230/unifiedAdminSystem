         </trim>
    </insert>

    <update id="updateAppPwa" parameterType="org.jeecg.modules.packagemanagement.domain.pwa.AppPwa">
        update pkg_pwa
        <trim prefix="SET" suffixOverrides=",">
            <if test="appName != null">app_name = #{appName},</if>
            <if test="appIcon != null">app_icon = #{appIcon},</if>
            <if test="appCode != null">app_code = #{appCode},</if>
