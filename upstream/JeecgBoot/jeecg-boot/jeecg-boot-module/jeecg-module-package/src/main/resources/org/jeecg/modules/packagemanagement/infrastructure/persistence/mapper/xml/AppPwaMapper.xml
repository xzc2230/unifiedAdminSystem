    <sql id="selectAppPwaVo">
        select id, app_name, app_icon, app_advertising, app_description, app_language, app_host,app_url, app_event, app_event_conf, user_id, app_create_time, app_change_time,app_sub_host,app_sub, link_id,public_key,private_key,download_url,app_type,app_code,reviews,download_count,score,tags from pkg_pwa
    </sql>

    <select id="selectAppPwaList" parameterType="org.jeecg.modules.packagemanagement.domain.pwa.AppPwa" resultMap="AppPwaResult">
        <include refid="selectAppPwaVo"/>
        <where>
            <if test="appName != null  and appName != ''"> and app_name like concat('%', #{appName}, '%')</if>
            <if test="appHost != null  and appHost != ''"> and app_host like concat('%', #{appHost}, '%')</if>
            <if test="appSub != null  and appSub != ''"> and app_sub like concat('%', #{appSub}, '%')</if>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="appUrl != null ">and app_url like concat('%', #{appUrl}, '%')</if>
            <if test="appType != null">and app_type = #{appType}</if>
            <if test="appCode != null">and app_code = #{appCode}</if>
        </where>
    </select>

    <select id="selectAppPwaById" parameterType="Long" resultMap="AppPwaResult">
        <include refid="selectAppPwaVo"/>
        where id = #{id}
    </select>

    <insert id="insertAppPwa" parameterType="org.jeecg.modules.packagemanagement.domain.pwa.AppPwa" useGeneratedKeys="true" keyProperty="id">
